# build output
/bin
*.exe
*.exe~
*.dll
*.so
*.dylib

# go test and coverage output
*.test
*.out
*.coverprofile
coverage.out

# dependencies and editors
vendor/
.idea/
.vscode/
*.iml
gin-bin

# binaries of the examples
/engine/cli/example/example
/feature/transform/martian/example/example
/feature/telemetry/metrics/examples/examples
/feature/connector/lambda/lambda

# TLS test certificates, generated by the tests
engine/transport/http/server/*.pem
feature/auth/jose/cert.pem
feature/auth/jose/key.pem

# plugins built by `make test-plugins`
tests/plugins/**/*.so

# raw per-run numbers of the benchmark; the report, summary.json and rps.svg are kept
benchmark/results/raw/
# plugins built by benchmark/run.sh
/benchmark/.plugins/
# routes config and URL list generated by benchmark/run.sh
/benchmark/.generated/
